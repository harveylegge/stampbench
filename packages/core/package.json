{
  "name": "@stampbench/core",
  "version": "0.1.2",
  "description": "Validate and generate EN 16931 / XRechnung e-invoices in pure TypeScript. UBL parsing, business-rule validation (BR, BR-CO, BR-DE), and compliant XML generation.",
  "author": "Harvey Legge (https://stampbench.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "xrechnung",
    "e-invoice",
    "e-rechnung",
    "en16931",
    "ubl",
    "invoice",
    "validation",
    "peppol",
    "factur-x",
    "zugferd",
    "compliance"
  ],
  "dependencies": {
    "fast-xml-parser": "^5.0.9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://stampbench.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harveylegge/stampbench.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/harveylegge/stampbench/issues"
  }
}
